package-as: Warcrest

# Release notes on GitHub and CurseForge: this version's part of the changelog
# (the release workflow writes RELEASE_NOTES.md from CHANGELOG.md), not commit messages.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - CONTRIBUTING.md
  - .github
  - .gitignore
  - .luacheckrc
  - tests
  - docs
  - tools
  - wiki
  - RELEASE_NOTES.md
  - design
